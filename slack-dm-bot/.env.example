# Secret configured on the GitHub webhook (generate with: openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=
# Your GitHub login; your own activity is skipped
GITHUB_USERNAME=
# Slack bot token (xoxb-...) with the chat:write scope
SLACK_BOT_TOKEN=
# Your Slack member ID (U...), the DM recipient
SLACK_USER_ID=
# Optional
LOG_LEVEL=INFO
