{
  "name": "github-extension",
  "version": "1.0.0",
  "description": "Chromium extension that opens GitHub pull request files locally and sends review requests to Slack.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "happy-dom": "^21.0.4",
    "playwright": "1.57",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "preact": "^11.1.0"
  },
  "private": true,
  "type": "module"
}
